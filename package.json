{
  "name": "rwi-vault",
  "version": "1.1.0",
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "hardhat": "^3.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.10.0 <22.18.0"
  },
  "scripts": {
    "test": "npx hardhat test",
    "test:coverage": "COVERAGE=1 npx hardhat test --coverage",
    "lint": "slippy \"contracts/**/*.sol\" \"test/**/*.sol\"",
    "typecheck": "npx hardhat build && npm run deployments:build && tsc --noEmit",
    "deployments:build": "node ./deployments/build.mjs"
  },
  "devDependencies": {
    "@nexusmutual/ethers-v6-aws-kms-signer": "^0.0.3",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@slippy-lint/slippy": "^0.2.2",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "mocha": "^11.8.0",
    "tsup": "^8.5.1",
    "typescript": "~7.0.2"
  }
}
