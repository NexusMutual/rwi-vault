{
  "name": "rwi-vault",
  "version": "1.1.0",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "hardhat": "^3.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.10.0 <22.18.0"
  },
  "scripts": {
    "test": "hardhat test",
    "test:coverage": "COVERAGE=1 hardhat test --coverage",
    "coverage:summary": "node ./scripts/coverage-summary.mjs",
    "storage:extract": "node ./scripts/extract-storage-layout.mjs",
    "lint": "slippy \"contracts/**/*.sol\" \"test/**/*.sol\"",
    "typecheck": "hardhat build && pnpm run deployments:build && tsc --noEmit",
    "deployments:build": "node ./deployments/build.mjs"
  },
  "devDependencies": {
    "@nexusmutual/ethers-v6-aws-kms-signer": "^0.0.3",
    "@nomicfoundation/hardhat-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.0",
    "@nomicfoundation/ignition-core": "^3.0.0",
    "@slippy-lint/slippy": "^0.0.12",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.17.1",
    "chai": "^5.2.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "mocha": "^11.7.1",
    "tsup": "^8.5.1",
    "typescript": "~5.8.0"
  },
  "pnpm": {
    "overrides": {
      "adm-zip@<0.6.0": "0.6.0",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-xml-builder@<=1.1.6": "1.1.7",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "lodash-es@<=4.17.23": "4.18.0",
      "lodash@<=4.17.23": "4.18.0",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "serialize-javascript@>=5.0.0 <7.0.5": "7.0.5",
      "undici@<6.28.0": "6.28.0",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
}
